# Vite loads these by mode:
#   .env.development  → npm run dev / preview:local
#   .env.production   → npm run dev:production / preview:production / build
#
# Optional local overrides (gitignored): .env.development.local, .env.production.local

# Local API (default for development)
PUBLIC_API_BASE=http://127.0.0.1:8000/api/v1

