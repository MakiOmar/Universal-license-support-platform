# Qwik Vite *dev server* must use `--mode ssr` (required by @builder.io/qwik).
# API targets are injected with Node `--env-file` so mode can stay `ssr`.
#
# Files:
#   .env.development     → npm run dev / preview:local  (localhost:8000)
#   .env.production-api  → npm run dev:production       (ulsp.gamesspoteg.com)
#   .env.production      → npm run preview:production / production build
#   .env.ssr             → fallback when running vite --mode ssr directly
#
# Optional overrides (gitignored): .env.*.local

PUBLIC_API_BASE=http://127.0.0.1:8000/api/v1
