# Vite loads these by mode:
#   .env.development     → npm run dev / preview:local
#   .env.production-api  → npm run dev:production (dev server + remote API)
#   .env.production      → npm run preview:production / production build
#
# Optional local overrides (gitignored): .env.*.local

# Local API (default for development)
PUBLIC_API_BASE=http://127.0.0.1:8000/api/v1

# Production API (see .env.production and .env.production-api)
# PUBLIC_API_BASE=https://ulsp.gamesspoteg.com/api/v1
